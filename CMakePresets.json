{
  "version": 6,
  "configurePresets": [
    {
      "name": "basis",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O2 -DNDEBUG",
        "CMAKE_C_FLAGS_RELEASE": "-O2 -DNDEBUG"
      }
    },
    {
      "name": "sdk",
      "inherits": "basis",
      "displayName": "GCC in org.freedesktop.Sdk//25.08 (Blender runtime)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang-libcxx",
      "inherits": "basis",
      "displayName": "Clang with libc++ (toolchain root in ARM_CLANG_ROOT)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{ARM_CLANG_ROOT}/bin/clang",
        "CMAKE_CXX_COMPILER": "$env{ARM_CLANG_ROOT}/bin/clang++",
        "CMAKE_SYSROOT": "$env{ARM_CLANG_ROOT}",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld -stdlib=libc++ -nostdlib++ -L$env{ARM_CLANG_ROOT}/lib64 -Wl,--exclude-libs,ALL",
        "CMAKE_CXX_STANDARD_LIBRARIES": "-Wl,-Bstatic -lc++ -lc++abi -Wl,-Bdynamic",
        "CMAKE_AR": "$env{ARM_CLANG_ROOT}/bin/llvm-ar",
        "CMAKE_RANLIB": "$env{ARM_CLANG_ROOT}/bin/llvm-ranlib"
      }
    },
    {
      "name": "windows",
      "displayName": "MSVC x64, static runtime (GitHub Actions)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "macos",
      "inherits": "basis",
      "displayName": "Apple Clang, universal arm64 + x86_64 (GitHub Actions)",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.2"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "sdk",
      "configurePreset": "sdk"
    },
    {
      "name": "clang-libcxx",
      "configurePreset": "clang-libcxx"
    },
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "Release"
    },
    {
      "name": "macos",
      "configurePreset": "macos",
      "jobs": 4
    }
  ]
}
